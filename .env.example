# Copy to `.env`. Every variable is read once, at start, by `src/platform/config.rs`.

# development | production. Production refuses to start on a missing secret or an http base URL.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
RUST_LOG=info,tablo_saas=debug
# text | json
LOG_FORMAT=text

DATABASE_URL=postgresql://saas:saas@127.0.0.1:5433/saas?sslmode=disable
DATABASE_POOL_SIZE=16

# openssl rand -hex 64. Signs upload links and seals two-factor secrets: rotating it locks every
# enrolled authenticator out, so keep it stable across restarts and replicas.
APP_COOKIE_KEY=

# CIDRs of the reverse proxies in front of the app, comma-separated. Empty trusts none.
TRUSTED_PROXIES=

# The sender, an address your provider has verified.
MAIL_FROM=no-reply@example.com
# Mailpit from `docker compose up`. Unset in development, mail goes to the log.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=

# Stripe, from a test-mode account. Leave them empty to run with billing off; production needs them.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/webhooks/stripe`, or the dashboard's endpoint.
STRIPE_WEBHOOK_SECRET=
# Only to aim the client at stripe-mock from `docker compose up`: http://127.0.0.1:12111
# STRIPE_API_BASE=
# Days a first subscription runs free. 0 for no trial.
BILLING_TRIAL_DAYS=14
# Collect tax through Stripe Tax, which the account must have turned on.
BILLING_AUTOMATIC_TAX=false
